{
  "manifest_version": 3,
  "name": "AI Usage",
  "version": "0.0.0.1",
  "description": "Track Claude, Codex, and Cursor usage limits in one place",
  "permissions": ["storage", "cookies"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://cursor.com/*",
    "https://cursor.sh/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}

{
  "name": "ai-usage",
  "version": "1.0.0",
  "description": "Chrome extension to track AI service usage limits",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/build.js --watch",
    "build": "bun run scripts/build.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "latest",
    "eslint": "latest",
    "happy-dom": "^20.3.9",
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "latest"
  },
  "lint-staged": {
    "*/**": [
      "prettier --write"
    ]
  }
}

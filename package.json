{
  "name": "ai-usage-tracker",
  "version": "1.0.0",
  "description": "Chrome extension to track AI service usage limits",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/build.js --watch",
    "build": "bun run scripts/build.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,jsx,css,html,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,jsx,css,html,md,json,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "husky": "latest",
    "lint-staged": "latest"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,html}": [
      "prettier --write"
    ]
  }
}

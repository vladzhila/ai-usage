{
  "name": "ai-usage",
  "version": "0.0.1",
  "description": "Chrome extension to track AI service usage limits",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/build.js --watch",
    "build": "bun run scripts/build.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/chrome": "^0.1.36",
    "eslint": "^9.39.2",
    "happy-dom": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "*/**": [
      "prettier --write --ignore-unknown"
    ]
  }
}
